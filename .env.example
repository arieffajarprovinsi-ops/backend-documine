# DocuMind Backend API Configuration (.env.example)
APP_NAME="DocuMind API"
APP_ENV="production"
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS="https://documine-tzlh.vercel.app,http://localhost:3000,http://127.0.0.1:3000"
FRONTEND_URL="https://documine-tzlh.vercel.app"

# OpenAI Official API & Provider-Flexible AIGateway (DECIDED: ADR-006, ADR-007, ADR-008, ADR-017)
AI_DEFAULT_PROVIDER="openai"
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_EMBEDDING_MODEL="text-embedding-3-large"
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_MODEL_FAST="gpt-6-luna"
OPENAI_MODEL_BALANCED="gpt-6.1-terra"
OPENAI_MODEL_DEEP="gpt-6.1-terra"
OPENAI_TTS_MODEL="tts-1-hd"
OPENAI_STORE_COMPLETIONS=false

# Supabase Configuration (PostgreSQL 16 + pgvector + Auth + Private Storage)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_STORAGE_BUCKET="documents"

# Redis & Background Worker Queue (arq)
REDIS_URL="redis://localhost:6379/0"
ENABLE_ARQ_WORKER=true

# Operational Quotas & Safety Limits
MAX_UPLOAD_SIZE_MB=50
MAX_VISION_OCR_PAGES=100
DEFAULT_WORKSPACE_STORAGE_LIMIT_MB=1024
DEFAULT_MONTHLY_AI_BUDGET_USD=5.00
REQUIRE_EMAIL_VERIFICATION=false
UPLOAD_DIR="./uploads"
